# camayoc core — the bootstrap vocabulary (slice 1: work + decisions)
#
# NAMESPACE NOTE (v1 pragmatism, revisit deliberately): quipu's /episode path
# emits node types and plain-named properties in the store's configured
# base_ns (default: the aegis namespace). So these terms are declared in that
# base namespace so that skill-guided episode writes and these declarations
# agree OUT OF THE BOX. A deployment that overrides [quipu] base_ns must load
# a regenerated copy — the namespace is a parameter, and this file's prefix is
# where it is set. See docs/design/bootstrap-ontology.md §1.
#
# Discipline: rdfs:range only, never rdfs:domain (Q-SARC-VOCAB — these
# predicates may later attach at statement level as well as node level).

@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .

# ---- Classes -----------------------------------------------------------

aegis:WorkItem a rdfs:Class ;
    rdfs:label "Work item" ;
    rdfs:comment "A unit of intended work (a task, a bead, an issue). Tracker-agnostic: models the work, never the tracker's message format." .

aegis:Decision a rdfs:Class ;
    rdfs:label "Decision" ;
    rdfs:comment "A choice made in the course of work: what was chosen, over what visible alternatives, why, by whom, under which work item. Recorded at the moment it happens." .

aegis:Verification a rdfs:Class ;
    rdfs:label "Verification" ;
    rdfs:comment "A claim that a check established something at a stated time. It is admissible only with the falsifier: the result that would have proved the claim wrong." .

aegis:ExecutionPath a rdfs:Class ;
    rdfs:label "Execution path" ;
    rdfs:comment "The concrete path by which a mechanism runs: the installed artifact, its repository source, and the refresh mechanism. It records provenance, not the decaying judgment that the path is live." .

aegis:Blocker a rdfs:Class ;
    rdfs:label "Blocker" ;
    rdfs:comment "A reason work cannot proceed. A blocker must say whether it is stated by a reporter or built from a demonstrated failing case; those are different evidence strengths." .

aegis:NonFunctionalRequirement a rdfs:Class ;
    rdfs:label "Nonfunctional requirement" ;
    rdfs:comment "A declared, testable service promise. It is separate from the Metric that claims to measure it so validity and coverage remain queryable." .

aegis:Metric a rdfs:Class ;
    rdfs:label "Metric" ;
    rdfs:comment "A catalogued measurement identity, its meaning, owner, probe, and executable retrieval method. Samples remain in the measurement system." .

aegis:Observation a rdfs:Class ;
    rdfs:label "Observation" ;
    rdfs:comment "An observed violation or decision input. It is deliberately not a time-series sample mirror." .

# ---- Source tier (the mandatory ingress tag) ---------------------------

aegis:sourceKind a rdf:Property ;
    rdfs:label "source kind" ;
    rdfs:comment "How this fact entered: observed (a record exists and was parsed), declared (a human said so), inferred (a model concluded it). Mandatory; SHACL-refused when absent. Never up-tag." ;
    rdfs:range xsd:string .

aegis:falsifier a rdf:Property ;
    rdfs:label "falsifier" ;
    rdfs:comment "The observable result that would have disproved a Verification. Mandatory: a check that cannot name its failing result is an assertion, not verification." ;
    rdfs:range xsd:string .

# ---- Execution provenance (M3) ----------------------------------------

aegis:executesArtifact a rdf:Property ;
    rdfs:label "executes artifact" ;
    rdfs:comment "The installed artifact that this ExecutionPath actually invokes. This is the execution target, not a claim that it is currently live." .

aegis:repositorySource a rdf:Property ;
    rdfs:label "repository source" ;
    rdfs:comment "The source artifact that should correspond to the executed artifact. Comparing these at read time detects armed-not-running drift." .

aegis:refreshedBy a rdf:Property ;
    rdfs:label "refreshed by" ;
    rdfs:comment "The mechanism responsible for refreshing the execution artifact from its source." .

aegis:lastRefreshedAt a rdf:Property ;
    rdfs:label "last refreshed at" ;
    rdfs:comment "The observed time the execution path was last refreshed. It is evidence for a read-time currency query, never a stored current/correct verdict." ;
    rdfs:range xsd:string .

aegis:ownedBy a rdf:Property ;
    rdfs:label "owned by" ;
    rdfs:comment "The principal that owns the path location. A single-principal owner is observable execution-path risk, not a liveness judgment." .

# ---- Blocker evidence (M4) --------------------------------------------

aegis:blockerEvidence a rdf:Property ;
    rdfs:label "blocker evidence kind" ;
    rdfs:comment "Whether a Blocker is stated (a report or ticket claim) or built (a constructed failing case). Readers must not present stated as demonstrated." ;
    rdfs:range xsd:string .

aegis:demonstratedBy a rdf:Property ;
    rdfs:label "demonstrated by" ;
    rdfs:comment "The Verification or other observed record that constructed and demonstrated a built blocker." .

# ---- Metrics and nonfunctional requirements ---------------------------

aegis:threshold a rdf:Property ;
    rdfs:label "threshold" ;
    rdfs:comment "The declared comparison and bound that makes a nonfunctional requirement testable." ;
    rdfs:range xsd:string .

aegis:unit a rdf:Property ;
    rdfs:label "unit" ;
    rdfs:range xsd:string .

aegis:measurementWindow a rdf:Property ;
    rdfs:label "measurement window" ;
    rdfs:range xsd:string .

aegis:meaning a rdf:Property ;
    rdfs:label "meaning" ;
    rdfs:range xsd:string .

aegis:metricName a rdf:Property ;
    rdfs:label "metric name" ;
    rdfs:comment "The measurement-system series or expression identity parsed from the source rule." ;
    rdfs:range xsd:string .

aegis:probe a rdf:Property ;
    rdfs:label "probe" ;
    rdfs:comment "The actual expression evaluated. An alert name is never a substitute for this mechanism." ;
    rdfs:range xsd:string .

aegis:measuresRequirement a rdf:Property ;
    rdfs:label "measures requirement" ;
    rdfs:comment "A Metric's claim that its probe tests a NonFunctionalRequirement. Keeping this as a claim makes invalid and orphan instrumentation queryable." .

aegis:gates a rdf:Property ;
    rdfs:label "gates" ;
    rdfs:comment "The alert, release, or decision surface gated by this metric." .

aegis:probeValidatedBy a rdf:Property ;
    rdfs:label "probe validated by" ;
    rdfs:comment "A falsifier-gated Verification that demonstrated the probe changes when the requirement is violated." .

aegis:observedAt a rdf:Property ;
    rdfs:label "observed at" ;
    rdfs:range xsd:string .

aegis:observedValue a rdf:Property ;
    rdfs:label "observed value" ;
    rdfs:range xsd:string .

aegis:contentHash a rdf:Property ;
    rdfs:label "content hash" ;
    rdfs:comment "A deterministic hash of the source definition used by reconcilers to distinguish unchanged from changed catalogue entries." ;
    rdfs:range xsd:string .

# ---- Work item properties ---------------------------------------------

aegis:createdAt a rdf:Property ;
    rdfs:label "created at" ;
    rdfs:range xsd:string .

aegis:closedAt a rdf:Property ;
    rdfs:label "closed at" ;
    rdfs:range xsd:string .

aegis:outcome a rdf:Property ;
    rdfs:label "outcome" ;
    rdfs:comment "What actually happened: done, abandoned, superseded, failed. Distinct from the decision that aimed at it. Set at close; absence means open — never store a decaying 'in progress'." ;
    rdfs:range xsd:string .

aegis:assignedTo a rdf:Property ;
    rdfs:label "assigned to" ;
    rdfs:comment "The principal a work item is assigned to. Agents are aegis:Principal, exactly as the graph already holds them." .

# ---- Decision properties ----------------------------------------------

aegis:decidedIn a rdf:Property ;
    rdfs:label "decided in" ;
    rdfs:comment "The work item (or session) a decision was made under." .

aegis:decidedBy a rdf:Property ;
    rdfs:label "decided by" .

aegis:chose a rdf:Property ;
    rdfs:label "chose" ;
    rdfs:comment "What was chosen. The one property a Decision cannot lack." ;
    rdfs:range xsd:string .

aegis:over a rdf:Property ;
    rdfs:label "over" ;
    rdfs:comment "The alternatives visible at the time. Absence means none were articulated — which is itself a fact worth knowing." ;
    rdfs:range xsd:string .

aegis:rationale a rdf:Property ;
    rdfs:label "rationale" ;
    rdfs:range xsd:string .

aegis:about a rdf:Property ;
    rdfs:label "about" ;
    rdfs:comment "The entity/topic a decision concerns, when one is nameable — the anchor 'what did we decide about X' resolves against." .

aegis:supersededBy a rdf:Property ;
    rdfs:label "superseded by" ;
    rdfs:comment "A later decision that replaces this one. The old decision is never deleted — bitemporality keeps it; this edge says who won." .

# ---- Golden paths (slice: trajectories, blessing, conformance) ----------
#
# Owed to competency/golden-paths.md; design in docs/design/golden-paths.md.
# Slice decisions made at minting time (the design's section 3 listed
# candidates and left the reified nodes open):
#   * omissions are reified as PathOmission nodes so each omission can carry
#     its authority — the statement-level attachment the vocabulary
#     discipline anticipates, without waiting for it;
#   * promotions are reified as PathPromotion events so blessingLevel is a
#     fact of the event, never a decaying judgment on the path;
#   * prunedFrom (an in-graph exemplar Trajectory) is the required provenance
#     of a GoldenPath; aegis:exemplar stays available, and optional, for
#     exemplars living outside this graph, matching quipu's governance use.

aegis:Trajectory a rdfs:Class ;
    rdfs:label "Trajectory" ;
    rdfs:comment "The observed, immutable record of the steps a work item actually took. Never edited after the fact; pruning authors a new GoldenPath, it never touches this." .

aegis:Step a rdfs:Class ;
    rdfs:label "Step" ;
    rdfs:comment "One action in a trajectory: actor, action, target, the Decision it enacts, the Verification it produced (if any), and its order. A step outside a trajectory is meaningless — stepOf is mandatory." .

aegis:GoldenPath a rdfs:Class ;
    rdfs:label "Golden path" ;
    rdfs:comment "A pruned, promoted trajectory class: completed work with verified results, distilled into the blessed way similar work goes. Cites the concrete Trajectories it was distilled from; carries its promotion history as PathPromotion events." .

aegis:PathOmission a rdfs:Class ;
    rdfs:label "Path omission" ;
    rdfs:comment "One pruning ruling: a step a GoldenPath deliberately excludes, carrying the authority for the cut — the deterministic cone analysis, or a human Decision. Pruning is curation, never erasure." .

aegis:PathPromotion a rdfs:Class ;
    rdfs:label "Path promotion" ;
    rdfs:comment "A promotion event on the blessing ladder: who promoted the path, when, to which level, citing which evidence. The level is a fact of this event at write time; a path's current fitness is a read-time judgment, never stored." .

# ---- Trajectory properties ----------------------------------------------

aegis:trajectoryOf a rdf:Property ;
    rdfs:label "trajectory of" ;
    rdfs:comment "The WorkItem this trajectory is the execution record of. Mandatory in spirit (Q1/Q2 join on it); permissive in the shape until the recording path settles." .

aegis:stepOf a rdf:Property ;
    rdfs:label "step of" ;
    rdfs:comment "The Trajectory this step belongs to. Mandatory: a step with no trajectory is an anecdote." .

aegis:stepOrder a rdf:Property ;
    rdfs:label "step order" ;
    rdfs:comment "The step's position in its trajectory's total order." ;
    rdfs:range xsd:integer .

aegis:actor a rdf:Property ;
    rdfs:label "actor" ;
    rdfs:comment "The principal that performed this step. Owed to competency golden-paths Q1; reuses whatever principal node the graph already holds." .

aegis:actionKind a rdf:Property ;
    rdfs:label "action kind" ;
    rdfs:comment "What kind of action the step is (edit, run, mail, decide, verify, ...). One half of the conformance grammar's v1 step signature." ;
    rdfs:range xsd:string .

aegis:actionTarget a rdf:Property ;
    rdfs:label "action target" ;
    rdfs:comment "What the step acted on. The other half of the v1 step signature; an IRI when the target is in the graph, a string when it is not." .

aegis:enacts a rdf:Property ;
    rdfs:label "enacts" ;
    rdfs:comment "The Decision this step enacts, when one was recorded." .

aegis:verifiedBy a rdf:Property ;
    rdfs:label "verified by" ;
    rdfs:comment "The Verification a step (or a trajectory's terminal claim) produced. Ranges over aegis:Verification, so the falsifier discipline applies unchanged — an unfalsifiable check never makes a trajectory admissible." .

# ---- Golden-path provenance and pruning ---------------------------------

aegis:prunedFrom a rdf:Property ;
    rdfs:label "pruned from" ;
    rdfs:comment "The exemplar Trajectory this GoldenPath was distilled from. Mandatory: a path that cannot cite the concrete success that justifies it is an opinion." .

aegis:omitsStep a rdf:Property ;
    rdfs:label "omits step" ;
    rdfs:comment "A PathOmission node recording one pruning ruling this GoldenPath made." .

aegis:omittedStep a rdf:Property ;
    rdfs:label "omitted step" ;
    rdfs:comment "The Step a PathOmission excludes." .

aegis:omissionAuthority a rdf:Property ;
    rdfs:label "omission authority" ;
    rdfs:comment "What authorized the cut: cone-analysis (the step is outside the provenance cone of the verified result — mechanical) or human-decision (a human overruled or supplemented the cone; omissionRuling names the Decision). Mandatory — an omission that cannot say who cut it is a silent edit of history." ;
    rdfs:range xsd:string .

aegis:omissionRuling a rdf:Property ;
    rdfs:label "omission ruling" ;
    rdfs:comment "The human Decision behind a human-decision omission, with its rationale." .

aegis:deadEnd a rdf:Property ;
    rdfs:label "dead end" ;
    rdfs:comment "The entry Step of an abandoned branch the exemplars explored, preserved as a hazard: a follower of this path should know what was tried that did not help. Negative knowledge, kept queryable." .

# ---- Blessing (promotion events) ----------------------------------------

aegis:promotes a rdf:Property ;
    rdfs:label "promotes" ;
    rdfs:comment "The GoldenPath this promotion event acts on." .

aegis:blessingLevel a rdf:Property ;
    rdfs:label "blessing level" ;
    rdfs:comment "The level this event promoted the path to: candidate, advisory, blessed, or constraint-backing. Recorded levels below candidate do not exist — recorded and verified are mechanical states derived at read time, not promotions." ;
    rdfs:range xsd:string .

aegis:promotedBy a rdf:Property ;
    rdfs:label "promoted by" ;
    rdfs:comment "The principal whose act this promotion is. Mandatory, and a human: nothing above verified happens without a recorded human act." .

aegis:promotedAt a rdf:Property ;
    rdfs:label "promoted at" ;
    rdfs:range xsd:string .

aegis:promotionEvidence a rdf:Property ;
    rdfs:label "promotion evidence" ;
    rdfs:comment "What the promoter looked at: a backtest report, a Verification, an advisory-period conformance record. A promotion citing nothing is answerable to competency Q8 as exactly that." .

# ---- Conformance ----------------------------------------------------------

aegis:followsPath a rdf:Property ;
    rdfs:label "follows path" ;
    rdfs:comment "A trajectory's (or work item's) declared claim to be an instance of a GoldenPath. A claim, not a verdict — conformance is evaluated at read time and by the guard, never asserted by the follower." .

aegis:deviatesAt a rdf:Property ;
    rdfs:label "deviates at" ;
    rdfs:comment "The Step at which an evaluated trajectory departed from the path it declared. Deviation is input to the record, not a judgment that the agent was wrong — demotion evidence only exists if deviations are recorded faithfully." .

aegis:derivedConstraint a rdf:Property ;
    rdfs:label "derived constraint" ;
    rdfs:comment "The aegis:Policy this GoldenPath backs, closing the audit chain constraint <- path <- exemplars. Far-horizon: gated on verdict signing; until then the ladder honestly stops at blessed." .
