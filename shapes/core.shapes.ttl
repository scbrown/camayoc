# camayoc core shapes — the gate (slice 1: work + decisions)
#
# Posture (inherited, deliberate): PERMISSIVE on domain shape, STRICT on the
# provenance tag. sourceKind is the reader's only signal of trust, so it is
# closed-vocabulary and mandatory from the first load; domain properties
# start permissive and tighten deliberately.
#
# Same base-namespace note as ontology/core.ttl: targets are declared in the
# store's default base_ns so /episode writes and these shapes agree out of
# the box.

@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix quipu: <http://quipu.dev/ontology/> .

aegis:CamayocWorkItemShape a sh:NodeShape ;
    sh:targetClass aegis:WorkItem ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every WorkItem carries exactly one sourceKind of observed|declared|inferred — the tag is the reader's only signal of trust" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a WorkItem needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:outcome ;
        sh:maxCount 1 ;
        sh:in ("done" "abandoned" "superseded" "failed") ;
        sh:message "camayoc: outcome, when set, is one of done|abandoned|superseded|failed — absence means open; never store a decaying 'in progress'" ;
    ] .

aegis:CamayocDecisionShape a sh:NodeShape ;
    sh:targetClass aegis:Decision ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every Decision carries exactly one sourceKind of observed|declared|inferred" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a Decision needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:chose ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a Decision without 'chose' is not a decision — record what was chosen" ;
    ] .

# Verification is deliberately stricter than the founding WorkItem/Decision
# shapes: its whole claim to trust is that it names the result that could have
# proved it wrong.  This is an ingress obligation, not a convention for a
# reader to remember.
aegis:CamayocVerificationShape a sh:NodeShape ;
    sh:targetClass aegis:Verification ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every Verification carries exactly one sourceKind of observed|declared|inferred — the tag is the reader's only signal of trust" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a Verification needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:falsifier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a Verification without a falsifier is an assertion, not verification — record the result that would have proved it wrong" ;
    ] .

# An execution path makes the running artifact and refresh chain queryable.
# It intentionally has no `isLive` field: live is a read-time verdict, while
# each property here is an observed or declared fact that remains true later.
aegis:CamayocExecutionPathShape a sh:NodeShape ;
    sh:targetClass aegis:ExecutionPath ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every ExecutionPath carries exactly one sourceKind of observed|declared|inferred" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: an ExecutionPath needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:executesArtifact ;
        sh:minCount 1 ;
        sh:message "camayoc: an ExecutionPath must name the artifact that actually executes" ;
    ] ;
    sh:property [
        sh:path aegis:repositorySource ;
        sh:minCount 1 ;
        sh:message "camayoc: an ExecutionPath must name the repository source to compare with its executed artifact" ;
    ] ;
    sh:property [
        sh:path aegis:refreshedBy ;
        sh:minCount 1 ;
        sh:message "camayoc: an ExecutionPath must name what refreshes its artifact" ;
    ] .

# The type-level distinction is deliberately mandatory. A stated ticket claim
# can be useful, but it must never read as a built reproduction. The optional
# demonstration link is type-checked when present; the producer integration
# that emits it belongs with hank/quipu, not a made-up write-time liveness rule.
aegis:CamayocBlockerShape a sh:NodeShape ;
    sh:targetClass aegis:Blocker ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
        sh:message "camayoc: every Blocker carries exactly one sourceKind of observed|declared|inferred" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message "camayoc: a Blocker needs exactly one rdfs:label" ;
    ] ;
    sh:property [
        sh:path aegis:blockerEvidence ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ("stated" "built") ;
        sh:message "camayoc: a Blocker must say whether its evidence is stated or built" ;
    ] ;
    sh:property [
        sh:path aegis:demonstratedBy ;
        sh:class aegis:Verification ;
        sh:message "camayoc: blocker demonstration must be a Verification" ;
    ] .

aegis:CamayocNonFunctionalRequirementShape a sh:NodeShape ;
    sh:targetClass aegis:NonFunctionalRequirement ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("declared") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:about ; sh:minCount 1 ] ;
    sh:property [ sh:path aegis:threshold ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:measurementWindow ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:createdAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

aegis:CamayocMetricShape a sh:NodeShape ;
    sh:targetClass aegis:Metric ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("declared") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:meaning ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:ownedBy ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path aegis:probe ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:measuresRequirement ; sh:minCount 1 ; sh:maxCount 1 ; sh:class aegis:NonFunctionalRequirement ] ;
    sh:property [ sh:path quipu:derivedBy ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path aegis:contentHash ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

aegis:CamayocObservationShape a sh:NodeShape ;
    sh:targetClass aegis:Observation ;
    sh:property [ sh:path aegis:sourceKind ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ("observed") ] ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:about ; sh:minCount 1 ] ;
    sh:property [ sh:path aegis:observedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path aegis:observedValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

aegis:CamayocMetricDerivationShape a sh:NodeShape ;
    sh:targetSubjectsOf quipu:derivationSystem ;
    sh:property [ sh:path quipu:derivationSystem ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path quipu:derivationQuery ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path quipu:derivationParams ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
