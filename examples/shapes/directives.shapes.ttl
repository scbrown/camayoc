# Minimal governance for aegis:Directive — the directive/policy example setup.
#
# camayoc's core shapes govern WorkItem and Decision but not Directive, whose
# full shape lives with the deployment's own ontology. This is the smallest
# shape that makes the class SANCTIONED on a receiver (a qpack whose data or
# queries target an unsanctioned class is quarantined) while holding the two
# properties the directive examples read: what a directive is about, and what
# superseded it. Reuses existing terms only (aegis:about, aegis:supersededBy,
# aegis:sourceKind); it mints nothing.

@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

aegis:CamayocExampleDirectiveShape a sh:NodeShape ;
    sh:targetClass aegis:Directive ;
    sh:property [
        sh:path aegis:sourceKind ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:in ("observed" "declared" "inferred") ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:string ;
    ] ;
    sh:property [
        sh:path aegis:about ;
        sh:nodeKind sh:IRI ;
    ] ;
    sh:property [
        sh:path aegis:supersededBy ;
        sh:class aegis:Directive ;
        sh:message "camayoc example: a directive is superseded by another directive the graph holds" ;
    ] .
