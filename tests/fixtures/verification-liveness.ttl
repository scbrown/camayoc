# Fixture graph for the verification-and-liveness competency queries.
#
# Deliberately seeded so each query has BOTH a positive finding and a control
# negative. The competency suite's own acceptance criterion demands this: "each
# query needs a seeded positive finding and a control negative; an empty result
# without those arms is not proof that the fleet is healthy." A fixture that
# only contains healthy data would let every query return zero rows and pass.

@prefix aegis: <http://aegis.gastown.local/ontology/> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:    <http://camayoc.test/fixture/> .

# --- Verifications --------------------------------------------------------
# Positive control for Q1: a well-formed verification that names its falsifier.
ex:verification-byte-identity
    a aegis:Verification ;
    rdfs:label "byte-identity check on the installed guard" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "a differing sha256 between installed and repository copy" .

ex:verification-schema-columns
    a aegis:Verification ;
    rdfs:label "schema comparison including column set" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "a column present in one schema and absent from the other" .

# Positive finding for Q2, and the reason Q2 exists at all.
#
# A Verification with no falsifier CANNOT be written through a gated ingress —
# the M1 shape refuses it (shapes/core.shapes.ttl:90). So this node models data
# that entered BEFORE the shape existed, or through a path that bypassed it.
# That is precisely the population Q2 is meant to find: the store's own legacy,
# not new writes. See tests/test_competency_queries.py for why this matters.
ex:verification-legacy-belt-and-braces
    a aegis:Verification ;
    rdfs:label "belt-and-braces guard check (pre-gate, A1)" ;
    aegis:sourceKind "observed" .

ex:verification-legacy-grep-count
    a aegis:Verification ;
    rdfs:label "grep -c over the test payload (pre-gate, A5)" ;
    aegis:sourceKind "observed" .

# --- Q3: falsifiers not re-run after a change (camayoc-89e) ---------------
# Both nodes verify the same landed claim; the change under test in the query
# arms is dated 2026-08-10T00:00:00Z. The stale one ran before it, the re-run
# one after. Every Verification here carries a falsifier: these entered
# through the gate, and they must not leak into Q2's pre-gate population.
ex:verification-fix-stale
    a aegis:Verification ;
    rdfs:label "guard fix verified once, before the config rewrite" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "the guard admitting an untagged write in the staging replay" ;
    aegis:verifies ex:claim-guard-fix-landed ;
    aegis:verifiedAt "2026-08-01T14:00:00Z" .

ex:verification-fix-rerun
    a aegis:Verification ;
    rdfs:label "guard fix re-verified after the config rewrite" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "the guard admitting an untagged write in the staging replay" ;
    aegis:verifies ex:claim-guard-fix-landed ;
    aegis:verifiedAt "2026-08-12T09:00:00Z" .

ex:claim-guard-fix-landed
    rdfs:label "claim: the ingress guard fix is landed and deployed" .

# --- Q4: proven adversarial vs only asserted (camayoc-89e) ----------------
# The proof node is itself a falsifier-gated Verification — sabotage that
# cannot name what flipping looks like proves nothing.
ex:check-proven-adversarial
    a aegis:Verification ;
    rdfs:label "schema gate check, sabotage-proven" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "an ADD COLUMN passing the gate unreported" ;
    aegis:adversariallyProvenBy ex:verification-sabotage-run .

ex:verification-sabotage-run
    a aegis:Verification ;
    rdfs:label "deliberate ADD COLUMN flipped the schema gate check" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "the gate staying green with the sabotage column in place" .

# Q4 control negative: a well-formed check nobody has sabotaged. The query
# must leave its proof column unbound, never fill one in.
ex:check-only-asserted
    a aegis:Verification ;
    rdfs:label "binding-condition check, asserted to work" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "the two branches evaluating differently under the probe input" .

# --- Q5: variable dependence of a check (camayoc-89e) ---------------------
# An adjacent-setting check whose mechanism's recorded dependences are what
# a reader compares against the changed variable. verification-byte-identity
# above records none — the control arm, which must read UNKNOWN, not
# 'independent'.
ex:check-adjacent-setting
    a aegis:Verification ;
    rdfs:label "gate check run in the staging tenant" ;
    aegis:sourceKind "observed" ;
    aegis:falsifier "the gate admitting the probe write in staging" ;
    aegis:dependsOnVariable "shacl-validate-on-write" ;
    aegis:dependsOnVariable "store-base-namespace" .

# --- Q7: blocked on a dependency already closed (camayoc-89e) -------------
# The measured failure: a P1 blocked 14 days on a dependency that had
# already cleared.
ex:item-blocked-on-closed
    a aegis:WorkItem ;
    rdfs:label "P1 waiting on the schema migration" ;
    aegis:sourceKind "declared" ;
    aegis:createdAt "2026-08-01T08:00:00Z" ;
    aegis:blockedOn ex:item-dependency-closed .

ex:item-dependency-closed
    a aegis:WorkItem ;
    rdfs:label "schema migration" ;
    aegis:sourceKind "declared" ;
    aegis:createdAt "2026-07-20T08:00:00Z" ;
    aegis:closedAt "2026-08-05T16:00:00Z" ;
    aegis:outcome "done" .

# Q7 control negatives: a block that still holds, and a closed item whose
# stale edge no longer blocks anything.
ex:item-blocked-on-open
    a aegis:WorkItem ;
    rdfs:label "waiting on the quipu refusal log" ;
    aegis:sourceKind "declared" ;
    aegis:createdAt "2026-08-10T08:00:00Z" ;
    aegis:blockedOn ex:item-dependency-open .

ex:item-dependency-open
    a aegis:WorkItem ;
    rdfs:label "quipu refusal log" ;
    aegis:sourceKind "declared" ;
    aegis:createdAt "2026-08-09T08:00:00Z" .

ex:item-closed-was-blocked
    a aegis:WorkItem ;
    rdfs:label "already-shipped item with a stale blocked edge" ;
    aegis:sourceKind "declared" ;
    aegis:createdAt "2026-07-01T08:00:00Z" ;
    aegis:closedAt "2026-07-15T12:00:00Z" ;
    aegis:outcome "done" ;
    aegis:blockedOn ex:item-dependency-closed .

# --- Blockers -------------------------------------------------------------
# Q10 needs both arms populated or it cannot show the distinction it exists for.
ex:blocker-stated
    a aegis:Blocker ;
    rdfs:label "upstream API said to be rate-limiting us" ;
    aegis:sourceKind "declared" ;
    aegis:blockerEvidence "stated" .

ex:blocker-built
    a aegis:Blocker ;
    rdfs:label "reproduced 429 with a minimal request loop" ;
    aegis:sourceKind "observed" ;
    aegis:blockerEvidence "built" ;
    aegis:demonstratedBy ex:verification-byte-identity .

# --- Execution paths ------------------------------------------------------
# Q11 positive: a fully-described path.
ex:path-shared-checkout
    a aegis:ExecutionPath ;
    rdfs:label "policy guard, shared read-only checkout" ;
    aegis:sourceKind "observed" ;
    aegis:executesArtifact "/opt/aegis/current/guard.sh" ;
    aegis:repositorySource "scbrown/camayoc:scripts/guard.sh" ;
    aegis:refreshedBy "deploy pipeline" ;
    aegis:lastRefreshedAt "2026-08-17T09:00:00Z" .

# Q13 positive: the single-principal-owned path, which is the risk shape.
ex:path-home-working-tree
    a aegis:ExecutionPath ;
    rdfs:label "policy guard, run from an individual working tree" ;
    aegis:sourceKind "observed" ;
    aegis:executesArtifact "/home/strider/camayoc/scripts/guard.sh" ;
    aegis:repositorySource "scbrown/camayoc:scripts/guard.sh" ;
    aegis:refreshedBy "whoever remembers to git pull" ;
    aegis:ownedBy ex:principal-strider ;
    aegis:lastRefreshedAt "2026-07-05T11:30:00Z" .

# Q13 control negative: also owned, but by a shared service principal. Present
# so the query cannot pass by returning every owned path indiscriminately —
# a reader must be able to tell these two apart.
ex:path-service-owned
    a aegis:ExecutionPath ;
    rdfs:label "metrics reconciler, service-owned location" ;
    aegis:sourceKind "observed" ;
    aegis:executesArtifact "/srv/aegis/reconcile.sh" ;
    aegis:repositorySource "scbrown/camayoc:scripts/reconcile_metrics.sh" ;
    aegis:refreshedBy "deploy pipeline" ;
    aegis:ownedBy ex:principal-shared-service ;
    aegis:lastRefreshedAt "2026-08-17T09:00:00Z" .

# --- Q12: source/artifact drift (camayoc-89e) -----------------------------
# Q12 positive: the digests differ — the rules-file-six-weeks-stale incident
# shape, observed in the store rather than judged.
ex:path-drifted
    a aegis:ExecutionPath ;
    rdfs:label "agent rules file, installed copy six weeks stale" ;
    aegis:sourceKind "observed" ;
    aegis:executesArtifact "/etc/aegis/rules.yml" ;
    aegis:repositorySource "scbrown/camayoc:config/rules.yml" ;
    aegis:refreshedBy "manual copy" ;
    aegis:artifactDigest "sha256:1f6c0f2a" ;
    aegis:sourceDigest "sha256:9b41d7e3" .

# Q12 control negative: both digests present and EQUAL. A query returning
# every digest-carrying path would report agreement as drift.
ex:path-in-sync
    a aegis:ExecutionPath ;
    rdfs:label "policy guard, installed copy matching source" ;
    aegis:sourceKind "observed" ;
    aegis:executesArtifact "/opt/aegis/current/policy.ttl" ;
    aegis:repositorySource "scbrown/camayoc:shapes/policies/edit-grounding.ttl" ;
    aegis:refreshedBy "deploy pipeline" ;
    aegis:artifactDigest "sha256:5d2e8c11" ;
    aegis:sourceDigest "sha256:5d2e8c11" .

# The undigested paths above (path-shared-checkout etc.) are Q12's second
# control: no digest is UNKNOWN, and UNKNOWN is never returned as drift.

# --- §D: cost and effort accounting (camayoc-e29, Q16-Q21) ----------------
# The suite's acceptance for this section: Q16 and Q18 must run against a
# fixture whose expected answer is known INDEPENDENTLY of the reader — a
# printed token count compared against the parsed one. So the totals below
# are stated here, as the numbers the harness rollout files print, and the
# tests assert the queries reproduce exactly these:
#
#   session-codex-a1   (strider, codex)  prints  41000 + 3000
#   session-claude-b2  (gonzo)           prints   9000 + 5000 (claude), 7000 (codex)
#   session-untracked  (strider)         prints NOTHING — the Q19 positive;
#                                        it must surface as UNKNOWN, never as 0
#
#   Q16 item-guard-fix     = 41000 + 9000          = 50000 (two principals)
#   Q18 strider            = 2 items closed, 41000 + 3000 = 44000 tokens
#   Q20 window [08-14,08-15) = claude 9000, codex 41000 + 7000 = 48000

ex:session-codex-a1
    a aegis:Session ;
    rdfs:label "codex rollout 2026-08-14, strider" ;
    aegis:sourceKind "observed" ;
    aegis:actor ex:principal-strider .

ex:session-claude-b2
    a aegis:Session ;
    rdfs:label "claude session 2026-08-14, gonzo" ;
    aegis:sourceKind "observed" ;
    aegis:actor ex:principal-gonzo .

# Q19 positive: parsed from the session log, but no usage record exists.
ex:session-untracked
    a aegis:Session ;
    rdfs:label "claude session 2026-08-13, strider, no accounting written" ;
    aegis:sourceKind "observed" ;
    aegis:actor ex:principal-strider .

ex:usage-codex-a1
    a aegis:UsageRecord ;
    rdfs:label "codex a1: 41000 tokens on the guard fix" ;
    aegis:sourceKind "observed" ;
    aegis:inSession ex:session-codex-a1 ;
    aegis:provider "codex" ;
    aegis:observedAt "2026-08-14T10:00:00Z" ;
    aegis:tokensConsumed 41000 ;
    aegis:attributedTo ex:item-guard-fix .

# Outside the [08-14, 08-15) window arms, and deliberately unattributed:
# consumption that belongs to no work item stays a session fact.
ex:usage-codex-late
    a aegis:UsageRecord ;
    rdfs:label "codex a1: 3000 tokens, unattributed, 08-16" ;
    aegis:sourceKind "observed" ;
    aegis:inSession ex:session-codex-a1 ;
    aegis:provider "codex" ;
    aegis:observedAt "2026-08-16T10:00:00Z" ;
    aegis:tokensConsumed 3000 .

ex:usage-claude-b2-1
    a aegis:UsageRecord ;
    rdfs:label "claude b2: 9000 tokens on the guard fix" ;
    aegis:sourceKind "observed" ;
    aegis:inSession ex:session-claude-b2 ;
    aegis:provider "claude" ;
    aegis:observedAt "2026-08-14T11:00:00Z" ;
    aegis:tokensConsumed 9000 ;
    aegis:attributedTo ex:item-guard-fix .

# On the 08-15 boundary: the window is half-open, so this is OUT of the
# 08-14 day and a boundary control for Q17/Q20.
ex:usage-claude-b2-2
    a aegis:UsageRecord ;
    rdfs:label "claude b2: 5000 tokens on the metrics doc" ;
    aegis:sourceKind "observed" ;
    aegis:inSession ex:session-claude-b2 ;
    aegis:provider "claude" ;
    aegis:observedAt "2026-08-15T09:00:00Z" ;
    aegis:tokensConsumed 5000 ;
    aegis:attributedTo ex:item-metrics-doc .

# One session, second provider: provider lives on the record, not the
# session, and Q17/Q20 group by exactly this.
ex:usage-gonzo-codex
    a aegis:UsageRecord ;
    rdfs:label "claude b2 session, codex leg: 7000 tokens, unattributed" ;
    aegis:sourceKind "observed" ;
    aegis:inSession ex:session-claude-b2 ;
    aegis:provider "codex" ;
    aegis:observedAt "2026-08-14T12:00:00Z" ;
    aegis:tokensConsumed 7000 .

# Work the consumption is attributed to, and the decisions made in it.
ex:item-guard-fix
    a aegis:WorkItem ;
    rdfs:label "fix the ingress guard bypass" ;
    aegis:sourceKind "declared" ;
    aegis:assignedTo ex:principal-strider ;
    aegis:createdAt "2026-08-13T08:00:00Z" ;
    aegis:closedAt "2026-08-14T18:00:00Z" ;
    aegis:outcome "done" .

ex:item-metrics-doc
    a aegis:WorkItem ;
    rdfs:label "write up the metrics reconciliation" ;
    aegis:sourceKind "declared" ;
    aegis:assignedTo ex:principal-strider ;
    aegis:createdAt "2026-08-14T08:00:00Z" ;
    aegis:closedAt "2026-08-15T12:00:00Z" ;
    aegis:outcome "done" .

ex:decision-rollback
    a aegis:Decision ;
    rdfs:label "roll the guard back rather than patch forward" ;
    aegis:sourceKind "declared" ;
    aegis:chose "rollback to the last verified guard" ;
    aegis:decidedIn ex:item-guard-fix .

# Q21 control: a decision whose work item carries no attributed usage.
# Its cost is UNKNOWN and the query must return no row — never 0.
ex:decision-unmeasured
    a aegis:Decision ;
    rdfs:label "wait for the quipu refusal log rather than poll" ;
    aegis:sourceKind "declared" ;
    aegis:chose "wait for the log" ;
    aegis:decidedIn ex:item-blocked-on-open .
